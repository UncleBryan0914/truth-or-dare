# 複製為 .env.local 並填入（勿 commit .env.local）
# 或在 Cursor Cloud Agent → Secrets 設定同名變數

# Supabase → Project Settings → API
GAME_API_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/rest/v1
GAME_API_KEY=your_supabase_anon_public_key
GAME_USE_SUPABASE=true

# 選填：代為寫入 Vercel 環境變數（需 Vercel Token）
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
